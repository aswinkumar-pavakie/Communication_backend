# =============================================================================
# Communication Assistant Backend - Environment Configuration
# Copy this file to .env and fill in real values. Never commit .env.
# =============================================================================

# --- Application ------------------------------------------------------------
NODE_ENV=development
PORT=3000
# Timezone used to decide "today" for streaks, today's activities and weekly charts.
APP_TIMEZONE=Asia/Kolkata
API_PREFIX=api/v1

# --- Database (Supabase PostgreSQL via Prisma) -------------------------------
# DATABASE_URL: pooled connection (pgbouncer, port 6543) - used at runtime
# DIRECT_URL: direct connection (port 5432) - used for migrations
DATABASE_URL="postgresql://postgres:<password>@<project-ref>.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:<password>@<project-ref>.pooler.supabase.com:5432/postgres"

# --- Auth / JWT ---------------------------------------------------------------
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# --- CORS ---------------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173,http://localhost:19006

# --- AI mode ------------------------------------------------------------------
# When AI_MODE=mock, provider settings below are ignored and mock providers are used.
AI_MODE=mock

# --- Speech-to-Text -------------------------------------------------------------
# Live provider: "groq" (model whisper-large-v3). STT_API_KEY is your Groq API key -
# the same key used for LLM_API_KEY below (one Groq account covers both).
STT_PROVIDER=mock
STT_API_KEY=

# --- Language Model ---------------------------------------------------------------
# Live provider: "groq" (model openai/gpt-oss-120b). LLM_API_KEY is your Groq API key.
LLM_PROVIDER=mock
LLM_API_KEY=

# --- Text-to-Speech -----------------------------------------------------------------
# Two live provider options:
#   "groq"   - Orpheus model, same Groq API key as STT_API_KEY/LLM_API_KEY, no billing
#              required. Free tier is tight (100 requests/day) and the model is newer/
#              less proven than Google's Neural2 voices.
#   "google" - Neural2 voices, far larger free quota (1M chars/month) but requires a
#              Google Cloud service-account JSON key (billing must be enabled on the
#              project, though usage within the free tier isn't charged). Download one
#              from Google Cloud Console (IAM & Admin > Service Accounts > Create Key >
#              JSON) for a project with "Cloud Text-to-Speech API" enabled, save the
#              file outside version control, and point GOOGLE_TTS_CREDENTIALS_PATH at
#              it. TTS_API_KEY is unused for this provider.
TTS_PROVIDER=mock
TTS_API_KEY=
GOOGLE_TTS_CREDENTIALS_PATH=

# --- Storage --------------------------------------------------------------------------
STORAGE_PROVIDER=supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=voice-recordings

# --- Email (password reset codes, streak reminders) --------------------------
# console = print emails in the backend log (works with no account - good for testing).
# resend  = send real email via https://resend.com (free tier). EMAIL_FROM must use a
#           domain verified in Resend (onboarding@resend.dev only delivers to your own address).
EMAIL_PROVIDER=console
RESEND_API_KEY=
EMAIL_FROM=Communication Assistant <onboarding@resend.dev>

# --- Rate limiting (requests per ttl window, seconds) --------------------------------
THROTTLE_TTL=60
THROTTLE_LIMIT=100
AI_THROTTLE_TTL=60
AI_THROTTLE_LIMIT=10
